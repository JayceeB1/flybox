{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flybox.dev/schemas/dataset-manifest.schema.json",
  "title": "FlyBox dataset manifest v1",
  "type": "object",
  "required": ["schema", "id", "release", "license_id", "retrieved_at", "code_revision", "files"],
  "properties": {
    "schema": {"const": "flybox.dataset-manifest/v1"},
    "id": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "license_id": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "bytes", "sha256", "license_id"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
