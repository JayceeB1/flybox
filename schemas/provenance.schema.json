{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flybox.dev/schemas/provenance.schema.json",
  "title": "FlyBox component provenance v1",
  "type": "object",
  "required": ["schema", "id", "kind", "version", "evidence", "license_id", "code_revision"],
  "properties": {
    "schema": {"const": "flybox.provenance/v1"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "evidence": {"enum": ["measured", "inferred", "modeled", "engineered", "derived"]},
    "license_id": {"type": "string", "minLength": 1},
    "code_revision": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inclusion_state": {
      "enum": ["dependency", "data", "adapted-code", "reference-only", "tooling", "original", "derived"]
    },
    "source": {
      "type": "object",
      "required": ["project"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "release": {"type": ["string", "null"]},
        "locators": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "derived_from": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "adapted_from": {
      "type": "object",
      "required": ["project", "revision", "license_id", "notice_path", "source_files"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "license_id": {"type": "string", "minLength": 1},
        "notice_path": {"type": "string", "minLength": 1},
        "source_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
